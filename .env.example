# _portal/.env.example — env vars del portal (UI en Astro sobre flow-engine)
#
# ZERO secrets de plataforma: _portal NO necesita TURSO_CONTROL_PLANE_*,
# CONTROL_PLANE_ENCRYPTION_KEY, SESSION_SECRET ni DB bindings. Toda la
# metadata llega via Service Binding RPC contra _auth (`env.AUTH`).
#
# Uso: cp .env.example .env.development
#
# Nota: en dev el worker corre en workerd con las vars de
# `wrangler.preview.jsonc` (Apple del plugin de CF para Vite no resuelve un
# config anidado por `env`). Este archivo es la fuente para el build/CSP
# (`astro.config.mjs` lee AUTH_BASE de acá).

APP_DOMAIN=localhost
NODE_ENV=development

# Puerto de _auth en dev (base del fake binding cuando no hay AUTH_BASE).
AUTH_PORT=3031

# Bases browser-visibles para links (logout / abrir app).
# Prod: https://auth.sivocloud.dev y https://apps.sivocloud.dev (defaults).
# Dev: auth local; las apps en sus puertos locales.
AUTH_BASE=http://localhost:3031
APPS_BASE=http://localhost:3032

# Override per-app (dev): JSON { "<slug>": "<base>" }. En prod NO se setea
# (todas las apps viven en apps.sivocloud.dev).
APP_BASES={"pos":"http://localhost:3032","b2b":"http://localhost:5173"}
