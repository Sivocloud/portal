# _portal/.env.example — env vars del portal (server-rendered, HTMX)
#
# Phase 4 (2026-09-14): _portal NO necesita TURSO_CONTROL_PLANE_*,
# CONTROL_PLANE_ENCRYPTION_KEY, SESSION_SECRET ni DB bindings. Toda la
# metadata de plataforma llega via Service Binding RPC contra _auth.
# Solo vars de config trivial (dominio / env / bases de links).

# Dev
APP_DOMAIN=localhost
NODE_ENV=development
PORT=3034

# Puerto de _auth (dev). Usado por fake-auth-binding (mock de `env.AUTH`).
AUTH_PORT=3031

# Bases browser-visibles para links (logout / abrir app).
# Prod: https://auth.sivocloud.dev y https://apps.sivocloud.dev (defaults).
# Dev: auth local; apps en sus puertos locales (sivo-pos-htmx corre en :3032).
AUTH_BASE=http://localhost:3031
APPS_BASE=http://localhost:3032

# Override per-app (dev): cada app local corre en su propio puerto, así que un
# solo APPS_BASE no alcanza. JSON { "<slug>": "<base>" }. En prod NO se setea
# (todas las apps viven en apps.sivocloud.dev).
# APP_BASES={"pos":"http://localhost:3032","b2b":"http://localhost:3033"}
