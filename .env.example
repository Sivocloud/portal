# _portal/.env.example — env vars template
#
# Phase 4 (2026-09-14): _portal NO necesita TURSO_CONTROL_PLANE_*,
# CONTROL_PLANE_ENCRYPTION_KEY, SESSION_SECRET ni DB bindings. Toda la
# metadata de plataforma llega via Service Binding RPC contra _auth.
# Solo se usan vars de config trivial (dominio / env).

# Dev
APP_DOMAIN=localhost
NODE_ENV=development

# Auth URL (dev: _auth corre en :3031; prod: auth.sivocloud.dev).
# Usado solo en dev para fake-auth-binding (mock de `env.AUTH`).
AUTH_PORT=3031
