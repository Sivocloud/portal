---
/**
 * Shell.astro — layout del portal: sidebar + topbar + content.
 *
 * Portado de `backend/src/ui/pages.js`. La estructura es la misma (misma UI):
 * sidebar izquierda con brand + nav + usuario/logout, topbar con el título y
 * el content server-rendered. Lo que cambia: es Astro (sin htmx, sin globals
 * ad-hoc), el CSS es un archivo real y el toggle de tema es un script
 * bundleado (CSP-safe).
 */
import '../styles/app.css'
import { ICONS } from '../lib/format'
import { NAV, NAV_SOON } from '../lib/nav'
import { getAuthBase } from '../server/lib/env.mjs'

interface Props {
  title?: string
  active?: string
  user?: { id?: string; role?: string }
  role?: string
  tenantId?: string
  flash?: { type: string; message: string } | null
}

const { title = 'Portal', active = '', user = {}, role = '', tenantId = '', flash = null } = Astro.props
const authBase = getAuthBase()
const userName = user.id ? String(user.id) : '—'
const roleLabel = role || user.role || ''
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · SIVOcloud</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23111827'/><circle cx='16' cy='16' r='6' fill='%232563eb'/></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Init del tema parser-blocking (sin flash). No es módulo a propósito. -->
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <div class="app">
      <aside class="sidebar">
        <div class="brand"><span class="dot"></span><span>SIVOcloud Portal</span></div>

        {NAV.map((i) => (
          <a class={`nav-item${active === i.key ? ' active' : ''}`} href={i.href}>
            <span class="ico" set:html={ICONS[i.icon]} />
            <span>{i.label}</span>
          </a>
        ))}

        <div class="nav-section">Próximamente</div>
        {NAV_SOON.map((i) => (
          <span class="nav-item soon" title="Próximamente">
            <span class="ico" set:html={ICONS[i.icon]} />
            <span>{i.label}</span>
          </span>
        ))}

        <div class="spacer"></div>

        <div class="user">
          <div><strong>{userName}</strong></div>
          <div class="muted">{roleLabel}{roleLabel && tenantId ? ' · ' : ''}{tenantId}</div>
          <div class="row mt">
            <button class="btn ghost sm" id="theme-toggle" type="button" title="Tema">
              <span class="ico" set:html={ICONS.theme} />
            </button>
            <form
              id="logout-form"
              method="POST"
              action={`${authBase}/api/auth/logout`}
              target="logout-sink"
              data-login={`${authBase}/login`}
            >
              <button class="btn ghost sm" type="submit">
                <span class="ico" set:html={ICONS.logout} />
                Salir
              </button>
            </form>
            <iframe name="logout-sink" title="logout" hidden></iframe>
          </div>
        </div>
      </aside>

      <main class="main">
        <header class="topbar">
          <h1>{title}</h1>
          <div id="topbar-slot"></div>
        </header>
        <div class="content"><slot /></div>
      </main>
    </div>

    <div id="toast">
      {flash && <div class={`toast ${flash.type}`}>{flash.message}</div>}
    </div>

    <script>
      // Toggle de tema: escribe la misma clave que `theme.js` lee en el <head>.
      // Astro lo bundlea → archivo hasheado (CSP-safe).
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        try { localStorage['sivo-portal_theme'] = next } catch {}
      })

      // Logout: el POST va a un iframe oculto (limpia la cookie en _auth) y
      // luego navegamos al login.
      const lf = document.getElementById('logout-form') as HTMLFormElement | null
      lf?.addEventListener('submit', () => {
        const login = lf.dataset.login || '/'
        setTimeout(() => { window.location.href = login }, 600)
      })

      // Toast (flash) auto-dismiss.
      document.querySelectorAll('#toast .toast').forEach((t) => {
        setTimeout(() => t.remove(), 3500)
      })
    </script>
  </body>
</html>
